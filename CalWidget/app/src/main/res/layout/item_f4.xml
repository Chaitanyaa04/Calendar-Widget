<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/blk" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/blk1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="8dp">
        <FrameLayout android:id="@+id/bar" android:layout_width="4dp" android:layout_height="match_parent" android:layout_marginEnd="10dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:fontFamily="casual" android:id="@+id/t" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:singleLine="true"/>
            <TextView android:fontFamily="casual" android:id="@+id/s" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true"/>
            <FrameLayout android:id="@+id/p" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="5dp" android:visibility="gone">
            <ImageView android:id="@+id/ptrack" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/pill"/>
            <ImageView android:id="@+id/pfill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/clip_pill"/>
        </FrameLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/badgeWrap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp">
            <ImageView android:id="@+id/pill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/pill"/>
            <TextView android:fontFamily="casual" android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="12sp" android:textStyle="bold" android:singleLine="true"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
