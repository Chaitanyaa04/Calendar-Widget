<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nroot" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/nbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp">
        <TextView android:id="@+id/nl" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/nt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="18sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/ns" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:singleLine="true"/>
        <Chronometer android:id="@+id/nch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textStyle="bold"/>
        <FrameLayout android:id="@+id/np" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:visibility="gone">
            <ImageView android:id="@+id/ntrack" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/pill"/>
            <ImageView android:id="@+id/nfill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/clip_pill"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
