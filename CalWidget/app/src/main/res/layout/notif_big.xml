<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:id="@+id/nb_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/blk2"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/nb_t" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:singleLine="true"/>
        <TextView android:id="@+id/nb_s" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="13sp" android:singleLine="true"/>
        <Chronometer android:id="@+id/nb_c" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:id="@+id/nb_r" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="28sp" android:textStyle="bold" android:visibility="gone"/>
        <LinearLayout android:id="@+id/nb_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
            <FrameLayout android:id="@+id/nb_bar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="14dp">
                <ImageView android:id="@+id/nb_btrack" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/pill"/>
                <ImageView android:id="@+id/nb_bfill" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/clip_pill"/>
            </FrameLayout>
            <TextView android:id="@+id/nb_p" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/nb_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="12sp" android:singleLine="true"/>
    </LinearLayout>
</FrameLayout>
